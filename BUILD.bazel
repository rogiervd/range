load("@rules_cc//cc:defs.bzl", "cc_library")

# The main target that should be used by other modules that want to depend on
# this library.
cc_library(
    name = "range",
    # Headers that a user of this library can include.
    hdrs = glob([
        "include/range/*.hpp",
        "include/range/detail/*.hpp",
        "include/range/helper/*.hpp",
        "include/range/any_range/*.hpp",
        "include/range/std/*.hpp",
        "include/range/std/detail/*.hpp",
        "include/range/python/*.hpp",
    ]),
    # Allow each header to be compiled on its own, to check that it includes
    # everything it needs.
    # This is enabled only for this target, so that the headers of dependencies
    # are not checked.
    # The check is run only when --process_headers_in_dependencies is passed:
    #   bazel build --keep_going --process_headers_in_dependencies //:range
    features = ["parse_headers"],
    include_prefix = "",
    # The prefix to be stripped from the include path.
    strip_include_prefix = "include/",
    visibility = ["//visibility:public"],
    # Dependencies of this library.
    deps = [
        "@boost.iostreams",  # TODO can we make this more specific?
        "@meta",
        "@rime",
        "@utility",
    ],
)

# All include files, for Doxygen to generate documentation from.
filegroup(
    name = "doc_sources",
    srcs = glob(["include/range/**"]),
    visibility = ["//documentation:__pkg__"],
)

exports_files(["requirements.txt"])
