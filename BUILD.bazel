load("@rules_cc//cc:defs.bzl", "cc_library")
load("@rules_python//python/uv:lock.bzl", "lock")

# The main target that should be used by other modules that want to depend on
# this library.
cc_library(
    name = "range",
    # Headers that a user of this library can include.
    hdrs = glob([
        "include/range/*.hpp",
        "include/range/detail/*.hpp",
        "include/range/helper/*.hpp",
        "include/range/any_range/*.hpp",
        "include/range/std/*.hpp",
        "include/range/std/detail/*.hpp",
    ]),
    include_prefix = "",
    # The prefix to be stripped from the include path.
    strip_include_prefix = "include/",
    visibility = ["//visibility:public"],
    # Dependencies of this library.
    deps = [
        "@boost.exception",
        "@boost.iostreams",
        "@meta",
        "@rime",
        "@utility",
    ],
)

cc_library(
    name = "range_python",
    # Headers that a user of this library can include.
    hdrs = glob([
        "include/range/python/*.hpp",
    ]),
    include_prefix = "",
    # The prefix to be stripped from the include path.
    strip_include_prefix = "include/",
    visibility = ["//visibility:public"],
    # Dependencies of this library.
    deps = [
        "//:range",
        "@nanobind_bazel//:nanobind",
    ],
)

# All include files, for Doxygen to generate documentation from.
filegroup(
    name = "doc_sources",
    srcs = glob(["include/range/**"]),
    visibility = ["//documentation:__pkg__"],
)

# Python requirements, used by pip.parse in MODULE.bazel.
# To regenerate requirements.txt from requirements.in, run
#   bazel run //:requirements
lock(
    name = "requirements_lock",
    srcs = ["requirements.in"],
    out = "requirements.txt",
)

alias(
    name = "requirements",
    actual = ":requirements_lock.update",
)
