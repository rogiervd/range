"""
This test builds four Python extensions, each tested with a .py test.
"""

load("@nanobind_bazel//:build_defs.bzl", "nanobind_extension")
load("@rules_python//python:py_test.bzl", "py_test")

test_names = [
    "python_range",
    "iterator",
    "tuple",
    "return_view",
]

[
    nanobind_extension(
        name = test_name + "_example",
        srcs = [test_name + "_example.cpp"],
        local_defines = ["NB_ABORT_ON_LEAK"],
        deps = [
            "@nanobind_bazel//:nanobind",
            "@range//:range_python",
        ],
    )
    for test_name in test_names
]

[
    py_test(
        name = "test-" + test_name,
        size = "small",
        srcs = [
            "pytest_main.py",
            "test-" + test_name + ".py",
        ],
        args = ["$(rootpath test-" + test_name + ".py)"],
        # The extension is data rather than a dependency: on Windows, it is a
        # .pyd file, which py_test does not accept in deps.
        # pytest_main.py adds this directory to the Python path.
        data = [
            "test-" + test_name + ".py",
            test_name + "_example",
        ],
        main = "pytest_main.py",
        deps = ["@range_pypi//pytest"],
    )
    for test_name in test_names
]
