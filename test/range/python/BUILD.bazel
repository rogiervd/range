"""
This test builds four Python extensions, each tested with a .py test.
"""

load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_cc//cc:cc_shared_library.bzl", "cc_shared_library")
load("@rules_python//python:py_test.bzl", "py_test")

test_names = [
    "python_range",
    "iterator",
    "tuple",
    "return_view",
]

# Each Python extension is a cc_library, wrapped in a cc_shared_library whose
# file name is the module name.
[
    [
        cc_library(
            name = test_name + "_example_lib",
            srcs = [test_name + "_example.cpp"],
            # nanobind declares its namespace with hidden visibility, so Python
            # extensions must be compiled with hidden visibility by default, as
            # nanobind's own build does. Otherwise, GCC warns that classes
            # (e.g. Boost.MPL templates instantiated with nanobind types) have
            # greater visibility than their bases.
            copts = select({
                # Windows has no symbol visibility, and clang-cl does not
                # accept -fvisibility.
                "@platforms//os:windows": [],
                "//conditions:default": ["-fvisibility=hidden"],
            }),
            local_defines = ["NB_ABORT_ON_LEAK"],
            deps = [
                "@nanobind",
                "@range//:range_python",
            ] + select({
                # On Windows, Python's headers make the linker look for the
                # Python library (e.g. python312.lib), so link with it.
                # Elsewhere, extensions must not link with libpython.
                "@platforms//os:windows": [
                    "@rules_python//python/cc:current_py_cc_libs",
                ],
                "//conditions:default": [],
            }),
        ),
        cc_shared_library(
            name = test_name + "_example",
            # Python on Windows only imports extension modules named .pyd.
            shared_lib_name = test_name + "_example" + select({
                "@platforms//os:windows": ".pyd",
                "//conditions:default": ".so",
            }),
            deps = [test_name + "_example_lib"],
        ),
    ]
    for test_name in test_names
]

[
    py_test(
        name = "test-" + test_name,
        size = "small",
        srcs = [
            "pytest_main.py",
            "test-" + test_name + ".py",
        ],
        args = ["$(rootpath test-" + test_name + ".py)"],
        data = [
            "test-" + test_name + ".py",
            test_name + "_example",
        ],
        main = "pytest_main.py",
        # Do not run these tests with sanitizers, because symbols can't be found
        # in the Python extension.
        tags = ["no-sanitizers"],
        deps = ["@range_pypi//pytest"],
    )
    for test_name in test_names
]
