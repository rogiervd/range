# Define the tests.

load("@rules_cc//cc:defs.bzl", "cc_test")

[
    cc_test(
        name = test_name,
        size = "small",
        srcs = [
            test_name + ".cpp",
            "//test/range:check_equal_behaviour.hpp",
        ],
        deps = [
            "//:range",
            "@boost.test//:unit_test_main",
        ],
    )
    for test_name in [
        "test-std_container",
        "test-std_tuple",
        "example-std_adaptor",
    ]
]

cc_test(
    name = "test-view_optional",
    size = "small",
    srcs = ["test-view_optional.cpp"],
    deps = [
        "//:range",
        # To test views of optional references, which std::optional does not
        # support.
        "@boost.optional",
        "@boost.test//:unit_test_main",
    ],
)
